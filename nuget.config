<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin restore to nuget.org for this repository. <clear/> drops any sources
    inherited from machine/user-level NuGet.Config (e.g. a private HTTP feed),
    which otherwise trip NU1507 (multiple sources under central package
    management) and NU1302 (HTTP source rejected). Every package this solution
    uses comes from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
