<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting via ASP.NET Core Module V2, in-process (SPEC section 2).
  Published by `dotnet publish`; this template documents the required settings.
  The AlwaysRunning app pool + site preload and the WebSocket role feature are
  configured in IIS, not here - see docs/SETUP.md.
  NOTE: keep this file ASCII-only. A stray non-ASCII byte (or a re-save in the
  wrong encoding) makes IIS reject it with HTTP 500.19 "not well-formed XML".
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdoutLogEnabled stays ON. A startup crash under IIS surfaces only as a bare
           500.30/502.5 page; the app's console sink (Program.cs) is the only place the real
           exception appears, and ANCM captures it here. The cost is one small file per
           process start in .\logs, which the deploy script provisions and cleans. Turning
           this off is what makes an IIS deploy undebuggable. NOTE: ANCM does not create the
           .\logs folder - if it is missing, nothing is written even with this set to true. -->
      <aspNetCore processPath=".\Logrr.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Point Logrr at its writable data directory. ApplicationPoolIdentity
               needs Modify on this folder only; the app folder stays read-only. -->
          <environmentVariable name="LOGRR_DATA_PATH" value="C:\Logrr" />
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Do NOT add <webSocket enabled="true" /> here. IIS ships the
           system.webServer/webSocket section with overrideModeDefault="Deny", so a
           web.config that sets it is rejected outright: HTTP 500.19, code 0x80070021,
           for EVERY request. That failure happens while IIS parses config, before the
           ASP.NET Core Module runs, so it produces no ANCM stdout log and no event log
           entry - the app looks dead with no diagnostics anywhere, while running
           Logrr.exe directly works fine.
           The element is redundant anyway: WebSockets are on by default at server level
           once the 'WebSocket Protocol' role feature is installed (see docs/SETUP.md).
           Without the feature SignalR just falls back to SSE/long-polling. -->
    </system.webServer>
  </location>
</configuration>
