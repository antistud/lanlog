<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting via ASP.NET Core Module V2, in-process (SPEC section 2).
  Published by `dotnet publish`; this template documents the required settings.
  The AlwaysRunning app pool + site preload and the WebSocket role feature are
  configured in IIS, not here - see docs/SETUP.md.
  NOTE: keep this file ASCII-only. A stray non-ASCII byte (or a re-save in the
  wrong encoding) makes IIS reject it with HTTP 500.19 "not well-formed XML".
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\Logrr.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Point Logrr at its writable data directory. ApplicationPoolIdentity
               needs Modify on this folder only; the app folder stays read-only. -->
          <environmentVariable name="LOGRR_DATA_PATH" value="C:\ProgramData\Logrr" />
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- WebSockets: install the IIS 'WebSocket Protocol' role feature so the realtime
           layer uses WebSockets rather than falling back to SSE/long-polling. -->
      <webSocket enabled="true" />
    </system.webServer>
  </location>
</configuration>
