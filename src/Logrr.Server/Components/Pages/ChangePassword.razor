@page "/account/password"
@attribute [Authorize]

<PageTitle>Change password — Logrr</PageTitle>

<div class="content" style="max-width:460px">
    <div class="page-head"><div><h1>Change password</h1>
        @if (MustChange)
        {
            <div class="sub">You're using a temporary password — set a new one to continue.</div>
        }
    </div></div>

    <div class="card">
        @if (Error is not null)
        {
            <div class="badge danger w-full" style="justify-content:center; padding:var(--sp-2); margin-bottom:var(--sp-4)">@Error</div>
        }
        <form method="post" action="/account/change-password" data-enhance="false">
            <div class="field">
                <label>Current password</label>
                <input class="input" name="currentPassword" type="password" autocomplete="current-password" autofocus />
            </div>
            <div class="field">
                <label>New password <span class="muted-2">(min 8 characters)</span></label>
                <input class="input" name="newPassword" type="password" autocomplete="new-password" />
            </div>
            <div class="field">
                <label>Confirm new password</label>
                <input class="input" name="confirmPassword" type="password" autocomplete="new-password" />
            </div>
            <button class="btn primary w-full" type="submit">Update password</button>
        </form>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }

    private bool MustChange;

    private string? Error => ErrorCode switch
    {
        "current" => "Current password is incorrect.",
        "length" => "New password must be at least 8 characters.",
        "match" => "New passwords do not match.",
        _ => null,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            MustChange = state.User.HasClaim(Logrr.Server.Auth.AuthEndpoints.MustChangeClaim, "1");
        }
    }
}
