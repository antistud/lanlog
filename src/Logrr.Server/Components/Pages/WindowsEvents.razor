@page "/admin/windows-events"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IDisposable
@using Logrr.Server.WindowsEvents
@using Logrr.Storage.Control
@inject Logrr.Server.WindowsEvents.WindowsEventSettings Winlog
@inject IServiceProvider Services

<PageTitle>Windows events — Logrr</PageTitle>

<div class="page-head">
    <div>
        <h1>Windows events</h1>
        <div class="sub">Agentless Event Log collection — the server reads these machines, nothing is installed on them.</div>
    </div>
    @if (_collector is not null && _enabled && _sources.Any(s => s.IsEnabled))
    {
        <button class="btn ghost" disabled="@_busy" @onclick="CollectNow">
            @(_busy ? "Collecting…" : "↻ Collect now")
        </button>
    }
</div>

@if (_collector is null)
{
    <div class="badge warn mb-4">
        This server is not running on Windows, so the Event Log cannot be read. Settings below can
        still be edited — they take effect if Logrr is moved to a Windows host.
    </div>
}

<div class="card">
    <div class="card-head">
        <div>
            <h3>Collection</h3>
            <div class="meta">Applies immediately — no restart, and no <code>appsettings.json</code>.</div>
        </div>
        <div class="flex gap-2 items-center">
            @if (_saved) { <span class="badge good">Saved</span> }
            <button class="btn primary sm" @onclick="SaveSettings">Save changes</button>
        </div>
    </div>

    <div class="field">
        <label class="flex gap-2 items-center" style="cursor:pointer">
            <input type="checkbox" @bind="_enabled" /> Collect Windows events
        </label>
        <span class="hint">When off, nothing is polled and the machines below are left alone.</span>
    </div>

    <div class="grid cols-4">
        <div class="field">
            <label>Poll interval (s)</label>
            <input class="input" type="number" @bind="_pollSeconds" />
            <span class="hint">@WindowsEventValidation.MinPollIntervalSeconds–@WindowsEventValidation.MaxPollIntervalSeconds. This is the collection latency.</span>
        </div>
        <div class="field">
            <label>Initial backfill (h)</label>
            <input class="input" type="number" @bind="_backfillHours" />
            <span class="hint">0 starts at the tail. Max @WindowsEventOptions.MaxInitialBackfillHours.</span>
        </div>
        <div class="field">
            <label>Events per read</label>
            <input class="input" type="number" @bind="_maxEvents" />
            <span class="hint">Batch size per query.</span>
        </div>
        <div class="field">
            <label>Reads per poll</label>
            <input class="input" type="number" @bind="_maxBatches" />
            <span class="hint">Caps how far one tick chases a backlog.</span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <div>
            <h3>Machines</h3>
            <div class="meta">One entry per machine. Each machine's events land in their own app, grouped one event type per Windows event id.</div>
        </div>
        <button class="btn primary sm" @onclick="() => OpenSource(null)">＋ Add machine</button>
    </div>

    @if (_sources.Count == 0)
    {
        <EmptyState Glyph="◫" Title="No machines yet">
            Add this server with <code>.</code> as the machine name, or any Windows box on the LAN
            by name. Permissions and firewall setup are in <code>docs/SETUP.md</code> §9.
        </EmptyState>
    }
    else
    {
        <div class="table-wrap" style="border:none">
            <table class="data">
                <thead>
                    <tr><th>Machine</th><th>App</th><th>Channels</th><th>Created floor</th><th>State</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in _sources)
                    {
                        <tr>
                            <td><strong>@s.Machine</strong>@if (s.Machine == ".") { <span class="meta" style="margin-left:6px">(this server)</span> }</td>
                            <td><a href="@($"/apps/{s.AppId}/search")">@s.AppId</a></td>
                            <td class="meta">@string.Join(", ", Channels(s))</td>
                            <td class="meta">@(s.MinimumLevel?.ToString() ?? "Warning")</td>
                            <td>
                                @if (s.IsEnabled) { <span class="badge accent">Collecting</span> }
                                else { <span class="badge">Paused</span> }
                            </td>
                            <td class="text-right nowrap">
                                <button class="btn ghost sm" @onclick="() => OpenSource(s)">Edit</button>
                                <button class="btn danger sm" @onclick="() => DeleteSource(s)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_collector is not null && _enabled && _rows.Count > 0)
{
    <div class="grid cols-4 mb-4">
        <StatTile Label="Machines" Value="@_machines.ToString()" Small="true" />
        <StatTile Label="Channels" Value="@_rows.Count.ToString()" Small="true" />
        <StatTile Label="Failing" Value="@_failing.ToString()" Small="true" Alert="_failing > 0" />
        <StatTile Label="Collected this run" Value="@_total.ToString("N0")" Small="true"
                  Foot="@(_collector.LastPollUtc is { } p ? $"last poll {Ago(p)}" : "no poll yet")" />
    </div>

    @if (_failing > 0)
    {
        <div class="badge warn mb-4">
            @_failing of @_rows.Count channel(s) could not be read. Almost always the app pool identity
            (it must be a domain account in <strong>Event Log Readers</strong> on the target) or the
            <strong>Remote Event Log Management</strong> firewall rule — see <code>docs/SETUP.md</code> §9.
        </div>
    }

    <div class="table-wrap">
        <table class="data">
            <thead>
                <tr>
                    <th>Machine</th><th>Channel</th><th>App</th><th>Status</th>
                    <th class="text-right">Collected</th><th class="text-right">Record</th><th>Last read</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>
                            <strong>@r.Machine</strong>
                            @if (!string.Equals(r.Machine, r.ConfiguredMachine, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="meta" style="margin-left:6px">(@r.ConfiguredMachine)</span>
                            }
                        </td>
                        <td><code>@r.Channel</code></td>
                        <td><a href="@($"/apps/{r.AppId}/search")">@r.AppId</a></td>
                        <td>
                            @if (r.IsFailing)
                            {
                                <span class="badge danger" title="@r.LastError">
                                    Failing @(r.ConsecutiveFailures > 1 ? $"({r.ConsecutiveFailures} polls)" : "")
                                </span>
                            }
                            else if (r.IsPending)
                            {
                                <span class="badge">Waiting for first poll</span>
                            }
                            else
                            {
                                <span class="badge accent">OK</span>
                            }
                        </td>
                        <td class="text-right">@r.EventsCollected.ToString("N0")</td>
                        <td class="text-right meta">@(r.LastRecordId?.ToString("N0") ?? "—")</td>
                        <td class="meta">@(r.LastSuccessUtc is { } s ? Ago(s) : "—")</td>
                        <td class="text-right">
                            <button class="btn ghost sm" title="Forget the high-water mark; the next poll starts again from the tail or the backfill window"
                                    @onclick="() => ResetCursor(r)">Reset</button>
                        </td>
                    </tr>
                    @if (r.IsFailing && r.LastError is not null)
                    {
                        <tr>
                            <td colspan="8" class="meta" style="padding-top:0; color:var(--danger)">@r.LastError</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<div class="card">
    <div class="card-head"><h3>How this works</h3></div>
    <div class="meta" style="line-height:1.7">
        Polling every @_pollSeconds s. Each channel keeps a high-water mark on its
        <code>EventRecordID</code>, so a restart resumes exactly where it left off, and clearing a log
        is detected and recovered from. Collection starts at the <strong>tail</strong> of each log —
        @(_backfillHours > 0
            ? $"except on first sight, where the last {_backfillHours}h are backfilled."
            : "only events written from then on appear. Set an initial backfill to pull history.")
        Filtering is each app's own <strong>minimum level</strong>: it is pushed into the Event Log
        query, so records below the floor are never read off the wire. The floor below is only used
        when the app is first created; change it afterwards in the app's own settings.
    </div>
</div>

<Modal @bind-Open="_showSource" Title="@(_editId is null ? "Add machine" : "Edit machine")">
    <ChildContent>
        <div class="field">
            <label>Machine</label>
            <input class="input" placeholder="WEB01" @bind="_fMachine" />
            <span class="hint">Name or FQDN, or <code>.</code> for this server. One entry per machine.</span>
        </div>
        <div class="field">
            <label>App id</label>
            <input class="input mono" placeholder="windows-web01" @bind="_fAppId" />
            <span class="hint">Created automatically on the first poll. 3–32 characters: <code>a-z</code>, <code>0-9</code>, <code>-</code>.</span>
        </div>
        <div class="field">
            <label>App name <span class="muted-2">(optional)</span></label>
            <input class="input" placeholder="WEB01 event log" @bind="_fAppName" />
        </div>
        <div class="field">
            <label>Channels</label>
            <input class="input mono" placeholder="Application, System" @bind="_fChannels" />
            <span class="hint">Comma-separated. Empty means Application and System. <code>Security</code> needs extra rights — see SETUP §9.</span>
        </div>
        <div class="grid cols-2">
            <div class="field">
                <label>Minimum level at creation</label>
                <select class="input" @bind="_fLevel">
                    @foreach (var l in Enum.GetValues<LogLevel>()) { <option value="@l">@l</option> }
                </select>
                <span class="hint">Seeds the new app only; afterwards its own setting governs.</span>
            </div>
            <div class="field">
                <label class="flex gap-2 items-center" style="cursor:pointer; margin-top:26px">
                    <input type="checkbox" @bind="_fEnabled" /> Collect from this machine
                </label>
            </div>
        </div>
        @if (_formErr is not null) { <div class="badge danger">@_formErr</div> }
    </ChildContent>
    <Footer>
        <button class="btn ghost" @onclick="() => _showSource = false">Cancel</button>
        <button class="btn primary" @onclick="SaveSource">@(_editId is null ? "Add machine" : "Save")</button>
    </Footer>
</Modal>

@code {
    private WindowsEventCollector? _collector;
    private IReadOnlyList<WindowsEventTargetStatus> _rows = [];
    private IReadOnlyList<WinlogSource> _sources = [];
    private int _machines, _failing;
    private long _total;
    private bool _busy;
    private CancellationTokenSource? _ticker;

    // Settings form.
    private bool _enabled, _saved;
    private int _pollSeconds, _maxEvents, _maxBatches, _backfillHours;

    // Machine form.
    private bool _showSource, _fEnabled = true;
    private string? _editId, _formErr;
    private string _fMachine = "", _fAppId = "", _fAppName = "", _fChannels = "";
    private LogLevel _fLevel = LogLevel.Warning;

    protected override void OnInitialized()
    {
        // Registered only on a Windows host, so its absence is exactly what distinguishes
        // "collection is off" from "this box cannot collect at all".
        _collector = Services.GetService<WindowsEventCollector>();
        LoadSettings();
        Refresh();

        // Collection happens on a background timer, so without this the page would silently go
        // stale while you watch it. Polling the in-memory status is cheap; the cursor and source
        // reads touch the control DB, and those are two small queries per tick.
        if (_collector is not null)
        {
            _ticker = new CancellationTokenSource();
            _ = TickAsync(_ticker.Token);
        }
    }

    private async Task TickAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(() => { Refresh(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException)
        {
            // Navigating away.
        }
    }

    public void Dispose()
    {
        _ticker?.Cancel();
        _ticker?.Dispose();
    }

    private void LoadSettings()
    {
        var s = Winlog.Settings();
        _enabled = s.Enabled;
        _pollSeconds = s.PollIntervalSeconds;
        _maxEvents = s.MaxEventsPerPoll;
        _maxBatches = s.MaxBatchesPerPoll;
        _backfillHours = s.InitialBackfillHours;
    }

    private void Refresh()
    {
        _sources = Winlog.Sources();
        if (_collector is null)
        {
            return;
        }
        _rows = _collector.Status();
        _machines = _rows.Select(r => r.Machine).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        _failing = _rows.Count(r => r.IsFailing);
        _total = _rows.Sum(r => r.EventsCollected);
    }

    private void SaveSettings()
    {
        Winlog.SaveSettings(new WinlogSettings
        {
            Enabled = _enabled,
            PollIntervalSeconds = _pollSeconds,
            MaxEventsPerPoll = _maxEvents,
            MaxBatchesPerPoll = _maxBatches,
            InitialBackfillHours = _backfillHours,
        });
        // Read back rather than trusting the form: the values are clamped on the way in, and
        // showing the number that was rejected would be a lie about what the collector will do.
        LoadSettings();
        _saved = true;
        Refresh();
    }

    private static IReadOnlyList<string> Channels(WinlogSource s) =>
        new WindowsEventSourceOptions { Channels = s.Channels }.EffectiveChannels;

    private void OpenSource(WinlogSource? s)
    {
        _formErr = null;
        _editId = s?.Id;
        _fMachine = s?.Machine ?? "";
        _fAppId = s?.AppId ?? "";
        _fAppName = s?.AppName ?? "";
        _fChannels = s is null ? "" : string.Join(", ", s.Channels);
        _fLevel = s?.MinimumLevel ?? LogLevel.Warning;
        _fEnabled = s?.IsEnabled ?? true;
        _showSource = true;
    }

    private void SaveSource()
    {
        var source = new WinlogSource
        {
            Id = _editId ?? Guid.NewGuid().ToString("N"),
            Machine = _fMachine,
            AppId = _fAppId,
            AppName = string.IsNullOrWhiteSpace(_fAppName) ? null : _fAppName.Trim(),
            Channels = WindowsEventValidation.ParseChannels(_fChannels),
            MinimumLevel = _fLevel,
            IsEnabled = _fEnabled,
            CreatedUtc = DateTimeOffset.UtcNow,
        };

        _formErr = Winlog.SaveSource(source, isNew: _editId is null);
        if (_formErr is not null)
        {
            return;
        }
        _showSource = false;
        Refresh();
    }

    private void DeleteSource(WinlogSource s)
    {
        Winlog.DeleteSource(s.Id);
        Refresh();
    }

    /// <summary>
    /// Forget a channel's cursor. The recovery hatch when a cursor has run ahead of the log —
    /// after a restore from backup, say — and collection has silently stopped as a result.
    /// </summary>
    private void ResetCursor(WindowsEventTargetStatus row)
    {
        Winlog.ResetCursor(row.ConfiguredMachine, row.Channel);
        Refresh();
    }

    /// <summary>
    /// Forces a poll rather than waiting out the interval — the thing you want immediately after
    /// fixing a permission. The collector serialises passes internally, so this cannot double-read.
    /// </summary>
    private async Task CollectNow()
    {
        if (_collector is null || _busy)
        {
            return;
        }
        _busy = true;
        try
        {
            await Task.Run(() => _collector.CollectOnce(CancellationToken.None));
        }
        finally
        {
            _busy = false;
            Refresh();
        }
    }

    private static string Ago(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        if (span < TimeSpan.Zero) { return "just now"; }
        if (span.TotalSeconds < 60) { return $"{(int)span.TotalSeconds}s ago"; }
        if (span.TotalMinutes < 60) { return $"{(int)span.TotalMinutes}m ago"; }
        if (span.TotalHours < 24) { return $"{(int)span.TotalHours}h ago"; }
        return when.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }
}
