@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IDisposable
@inject Logrr.Server.LiveSignals Signals
@inject Logrr.Storage.IngestPipeline Ingest
@inject Logrr.Realtime.RealtimeBroker Broker
@inject Logrr.Notify.DeliveryStore Deliveries
@inject Logrr.Storage.StoragePaths Paths
@inject Logrr.Storage.Control.UserStore Users
@inject Logrr.Server.WindowsAuthOptions WindowsAuth
@inject Logrr.Server.Ingest.IngestCorsPolicy Cors
@inject Microsoft.Extensions.Options.IOptions<Logrr.Server.ServerOptions> Options

<PageTitle>Admin — Logrr</PageTitle>

<div class="page-head">
    <div><h1>Admin</h1><div class="sub">Health, users, and the server's own diagnostics.</div></div>
    <button class="btn ghost" @onclick="Refresh">↻ Refresh</button>
</div>

<div class="grid cols-4 mb-4">
    <StatTile Label="Ingest queue" Value="@_queue.ToString()" Small="true" />
    <StatTile Label="Dropped" Value="@_dropped.ToString()" Small="true" Alert="_dropped > 0" />
    <StatTile Label="Disk free" Value="@($"{_diskMb:N0} MB")" Small="true" Alert="_diskMb < Options.Value.MinFreeDiskMb" />
    <StatTile Label="Subscriptions" Value="@_subs.ToString()" Small="true" />
    <StatTile Label="Pending deliveries" Value="@_pending.ToString()" Small="true" />
    <StatTile Label="Dead-lettered" Value="@_dead.ToString()" Small="true" Alert="_dead > 0" />
</div>

<div class="card">
    <div class="card-head">
        <div>
            <h3>Users</h3>
            @if (!WindowsAuth.Enabled)
            {
                <div class="meta">Windows sign-in is off. Links set here take effect once <code>Logrr:Auth:Windows:Enabled</code> is true.</div>
            }
        </div>
        <button class="btn primary sm" @onclick="() => _showUser = true">＋ New user</button>
    </div>
    <div class="table-wrap" style="border:none">
        <table class="data">
            <thead><tr><th>Username</th><th>Role</th><th>Windows sign-in</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in _users)
                {
                    <tr>
                        <td><strong>@u.Username</strong>@if (u.MustChangePassword) { <span class="badge warn" style="margin-left:6px">must change password</span> }</td>
                        <td>
                            @if (u.Role == Logrr.Storage.Control.UserRole.Admin) { <span class="badge accent">Admin</span> }
                            else { <span class="badge">User</span> }
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(u.WindowsAccount)) { <span class="meta">—</span> }
                            else
                            {
                                <code class="meta">@u.WindowsAccount</code>
                                @if (u.PasswordHash is null) { <span class="badge" style="margin-left:6px" title="No password set — this account can only sign in with Windows">Windows only</span> }
                            }
                        </td>
                        <td class="meta">@u.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="text-right nowrap">
                            <button class="btn ghost sm" @onclick="() => OpenWindows(u)">Windows account</button>
                            <button class="btn ghost sm" @onclick="() => OpenReset(u)">Reset password</button>
                            @if (u.Username != _currentUser)
                            {
                                <button class="btn danger sm" @onclick="() => DeleteUser(u.Id)">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <div>
            <h3>Browser origins (CORS)</h3>
            <div class="meta">Websites allowed to post logs from the browser. Ingest still requires a valid token.</div>
        </div>
    </div>
    <div class="field" style="margin-bottom:var(--sp-3)">
        <div class="flex gap-2">
            <input class="input" placeholder="https://app.example.com" @bind="_originInput" @bind:event="oninput"
                   @onkeydown="@(e => { if (e.Key == "Enter") AddOrigin(); })" />
            <button class="btn primary" @onclick="AddOrigin">Add origin</button>
        </div>
        @if (_originErr is not null) { <span class="hint" style="color:var(--danger)">@_originErr</span> }
        else { <span class="hint">Scheme + host + optional port, no path — e.g. <code>https://app.example.com</code>.</span> }
    </div>

    @if (Cors.AllowAny)
    {
        <div class="badge warn">No origins listed — <strong>any</strong> website may post with a valid token. Add one to lock it down.</div>
    }

    <div class="table-wrap" style="border:none">
        <table class="data">
            <thead><tr><th>Origin</th><th>Source</th><th>Added</th><th></th></tr></thead>
            <tbody>
                @foreach (var o in Cors.ConfigOrigins)
                {
                    <tr>
                        <td><code>@o</code></td>
                        <td><span class="badge">config</span></td>
                        <td class="meta">—</td>
                        <td class="text-right"><span class="meta" title="Set in Ingest:AllowedOrigins">read-only</span></td>
                    </tr>
                }
                @foreach (var o in _origins)
                {
                    <tr>
                        <td><code>@o.Origin</code></td>
                        <td><span class="badge accent">UI</span></td>
                        <td class="meta">@o.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="text-right"><button class="btn danger sm" @onclick="() => RemoveOrigin(o.Origin)">Remove</button></td>
                    </tr>
                }
                @if (_origins.Count == 0 && Cors.ConfigOrigins.Count == 0)
                {
                    <tr><td colspan="4" class="meta">No origins configured.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-head"><h3>Internal log</h3><span class="meta">@_logName</span></div>
    <pre class="code" style="max-height:340px; overflow:auto">@(_log.Length == 0 ? "(empty)" : _log)</pre>
</div>

<Modal @bind-Open="_showUser" Title="New user">
    <ChildContent>
        <div class="field"><label>Username</label><input class="input" @bind="_uName" /></div>
        <div class="field">
            <label>Password</label>
            <input class="input" type="password" @bind="_uPass" />
            <span class="hint">Optional if a Windows account is set — leave blank for Windows-only sign-in.</span>
        </div>
        <div class="field">
            <label>Windows account</label>
            <input class="input" placeholder="CONTOSO\jrhoades" @bind="_uWin" />
            <span class="hint">Signs in automatically as this user. Domain or machine qualified, e.g. <code>CONTOSO\jrhoades</code>.</span>
        </div>
        <div class="field">
            <label>Role</label>
            <select class="input" @bind="_uRole">
                <option value="User">User</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        @if (_uErr is not null) { <div class="badge danger">@_uErr</div> }
    </ChildContent>
    <Footer>
        <button class="btn ghost" @onclick="() => _showUser = false">Cancel</button>
        <button class="btn primary" @onclick="CreateUser">Create user</button>
    </Footer>
</Modal>

<Modal @bind-Open="_showWin" Title="@($"Windows account — {_winName}")">
    <ChildContent>
        <div class="field">
            <label>Windows account</label>
            <input class="input" placeholder="CONTOSO\jrhoades" @bind="_winAccount" />
            <span class="hint">
                Exactly as Windows reports it, e.g. <code>CONTOSO\jrhoades</code> or <code>SERVER01\jrhoades</code>.
                Case does not matter. Clear the field to unlink.
            </span>
        </div>
        @if (_winErr is not null) { <div class="badge danger">@_winErr</div> }
    </ChildContent>
    <Footer>
        <button class="btn ghost" @onclick="() => _showWin = false">Cancel</button>
        <button class="btn primary" @onclick="SaveWindows">Save</button>
    </Footer>
</Modal>

<Modal @bind-Open="_showReset" Title="@($"Reset password — {_resetName}")">
    <ChildContent>
        <div class="field">
            <label>New password</label>
            <input class="input" type="password" @bind="_resetPass" />
            <span class="hint">The user must change it again on their next sign-in.</span>
        </div>
        @if (_resetErr is not null) { <div class="badge danger">@_resetErr</div> }
    </ChildContent>
    <Footer>
        <button class="btn ghost" @onclick="() => _showReset = false">Cancel</button>
        <button class="btn primary" @onclick="ResetPassword">Reset password</button>
    </Footer>
</Modal>

@code {
    private int _queue, _subs, _pending, _dead;
    private long _dropped, _diskMb;
    private IReadOnlyList<Logrr.Storage.Control.UserRecord> _users = [];
    private string _log = "", _logName = "";

    private bool _showUser;
    private string _uName = "", _uPass = "", _uRole = "User", _uWin = "";
    private string? _uErr;

    private bool _showWin;
    private string _winId = "", _winName = "", _winAccount = "";
    private string? _winErr;

    private bool _showReset;
    private string _resetId = "", _resetName = "", _resetPass = "";
    private string? _resetErr;
    private string? _currentUser;

    private IReadOnlyList<Logrr.Storage.Control.CorsOrigin> _origins = [];
    private string _originInput = "";
    private string? _originErr;

    private DateTimeOffset _lastLoad;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            _currentUser = (await AuthState).User.Identity?.Name;
        }
    }

    protected override void OnInitialized()
    {
        Refresh();
        Signals.AppActivity += OnActivity;
        Signals.DeliveriesChanged += OnDeliveries;
    }

    private void OnActivity(string _) => Throttled();
    private void OnDeliveries() => Throttled();

    private void Throttled()
    {
        if (DateTimeOffset.UtcNow - _lastLoad < TimeSpan.FromSeconds(1))
        {
            return;
        }
        _lastLoad = DateTimeOffset.UtcNow;
        InvokeAsync(() => { Refresh(); StateHasChanged(); });
    }

    public void Dispose()
    {
        Signals.AppActivity -= OnActivity;
        Signals.DeliveriesChanged -= OnDeliveries;
    }

    private void Refresh()
    {
        _queue = Ingest.QueueDepth;
        _dropped = Ingest.DroppedTotal;
        _subs = Broker.ActiveCount;
        _pending = Deliveries.CountByStatus(Logrr.Notify.DeliveryStatus.Pending);
        _dead = Deliveries.CountByStatus(Logrr.Notify.DeliveryStatus.DeadLettered);
        _diskMb = DiskFreeMb();
        _users = Users.List();
        _origins = Cors.Managed();
        LoadLog();
    }

    private void AddOrigin()
    {
        _originErr = null;
        if (string.IsNullOrWhiteSpace(_originInput)) { return; }
        var normalized = Cors.Add(_originInput);
        if (normalized is null)
        {
            _originErr = "Enter a valid http(s) origin, e.g. https://app.example.com";
            return;
        }
        _originInput = "";
        _origins = Cors.Managed();
    }

    private void RemoveOrigin(string origin)
    {
        Cors.Remove(origin);
        _origins = Cors.Managed();
    }

    private long DiskFreeMb()
    {
        try
        {
            var root = Path.GetPathRoot(Path.GetFullPath(Paths.DataRoot));
            return string.IsNullOrEmpty(root) ? 0 : new DriveInfo(root).AvailableFreeSpace / (1024 * 1024);
        }
        catch { return 0; }
    }

    private void LoadLog()
    {
        try
        {
            var file = Directory.EnumerateFiles(Paths.DataRoot, "logrr-internal*.log")
                .OrderByDescending(File.GetLastWriteTimeUtc).FirstOrDefault();
            if (file is null) { _log = ""; _logName = "no log file"; return; }
            _logName = Path.GetFileName(file);
            using var fs = new FileStream(file, FileMode.Open, FileAccess.Read, FileShare.ReadWrite);
            using var sr = new StreamReader(fs);
            var lines = sr.ReadToEnd().Split('\n');
            _log = string.Join('\n', lines.TakeLast(120));
        }
        catch (IOException) { _log = "(could not read log)"; }
    }

    private void CreateUser()
    {
        _uErr = null;
        var win = _uWin.Trim();
        if (string.IsNullOrWhiteSpace(_uName)) { _uErr = "username required"; return; }
        if (string.IsNullOrWhiteSpace(_uPass) && win.Length == 0) { _uErr = "set a password, a Windows account, or both"; return; }
        if (Users.GetByUsername(_uName) is not null) { _uErr = "username already exists"; return; }
        if (win.Length > 0)
        {
            if (WindowsAccountError(win) is { } err) { _uErr = err; return; }
            if (Users.GetByWindowsAccount(win) is not null) { _uErr = "another user is already linked to that Windows account"; return; }
        }

        // No password means Windows-only: the sign-in form rejects an account with no hash, so the
        // Windows link is the sole way in.
        byte[]? hash = null, salt = null;
        if (!string.IsNullOrWhiteSpace(_uPass))
        {
            (hash, salt) = Logrr.Server.Security.PasswordHasher.Create(_uPass);
        }

        Users.Create(new Logrr.Storage.Control.UserRecord
        {
            Id = Guid.NewGuid().ToString("N"),
            Username = _uName,
            PasswordHash = hash,
            PasswordSalt = salt,
            WindowsAccount = win.Length == 0 ? null : win,
            Role = _uRole == "Admin" ? Logrr.Storage.Control.UserRole.Admin : Logrr.Storage.Control.UserRole.User,
            MustChangePassword = false,
            CreatedUtc = DateTimeOffset.UtcNow,
        });
        _showUser = false;
        _uName = ""; _uPass = ""; _uWin = "";
        Refresh();
    }

    private void OpenWindows(Logrr.Storage.Control.UserRecord u)
    {
        _winId = u.Id; _winName = u.Username; _winAccount = u.WindowsAccount ?? ""; _winErr = null;
        _showWin = true;
    }

    private void SaveWindows()
    {
        _winErr = null;
        var account = _winAccount.Trim();
        if (account.Length > 0 && WindowsAccountError(account) is { } err) { _winErr = err; return; }
        if (!Users.SetWindowsAccount(_winId, account.Length == 0 ? null : account))
        {
            _winErr = "another user is already linked to that Windows account";
            return;
        }
        _showWin = false;
        Refresh();
    }

    /// <summary>
    /// A bare "jrhoades" never matches what the server reports, so the link would silently never
    /// fire. Catch that here rather than at a failed sign-in.
    /// </summary>
    private static string? WindowsAccountError(string account) =>
        account.Contains('\\') || account.Contains('@')
            ? null
            : "qualify the account, e.g. CONTOSO\\jrhoades or jrhoades@contoso.com";

    private void OpenReset(Logrr.Storage.Control.UserRecord u)
    {
        _resetId = u.Id; _resetName = u.Username; _resetPass = ""; _resetErr = null;
        _showReset = true;
    }

    private void ResetPassword()
    {
        _resetErr = null;
        if (_resetPass.Length < 8) { _resetErr = "password must be at least 8 characters"; return; }
        var (hash, salt) = Logrr.Server.Security.PasswordHasher.Create(_resetPass);
        Users.UpdatePassword(_resetId, hash, salt, mustChange: true);
        _showReset = false;
        Refresh();
    }

    private void DeleteUser(string id)
    {
        Users.Delete(id);
        Refresh();
    }
}
