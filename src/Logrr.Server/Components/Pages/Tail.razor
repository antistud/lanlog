@page "/apps/{AppId}/tail"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject Logrr.Realtime.RealtimeBroker Broker
@inject Logrr.Notify.TicketLinkStore TicketLinks
@inject Logrr.Storage.EventReader Reader
@inject Logrr.Storage.Control.AckStore Acks
@inject AuthenticationStateProvider AuthState

<PageTitle>@AppId · live tail — Logrr</PageTitle>

<AppTabs AppId="@AppId" Active="tail" Title="Live tail">
    <div class="flex gap-2 items-center">
        <button class="btn ghost sm" @onclick="() => _showDocs = !_showDocs">
            @(_showDocs ? "Hide setup" : "Send logs")
        </button>
        <span class="badge @(_paused ? "warn" : "good")">
            @if (_paused) { <span class="dot"></span><text> Paused</text> } else { <span class="dot-live"></span><text> Streaming</text> }
        </span>
    </div>
</AppTabs>

@if (_showDocs || _rows.Count == 0)
{
    <div class="mb-4"><IngestDocs AppId="@AppId" /></div>
}

<div class="card" style="padding:var(--sp-3) var(--sp-4); margin-bottom:var(--sp-4)">
    <div class="row">
        <div class="field" style="margin:0; min-width:150px">
            <label>Minimum level</label>
            <select class="input" @bind="_minLevel" @bind:after="Resubscribe">
                @foreach (var l in Levels) { <option value="@l">@l</option> }
            </select>
        </div>
        <div class="field flex-1" style="margin:0; min-width:260px">
            <label>Filter expression</label>
            <input class="input mono" @bind="_filter" @bind:after="Resubscribe"
                   placeholder="Level >= Error and UserId = 1042" />
        </div>
        <div class="flex gap-2" style="align-self:flex-end">
            <button class="btn" @onclick="TogglePause">@(_paused ? "▶ Resume" : "⏸ Pause")</button>
            <button class="btn ghost" @onclick="Clear">Clear</button>
        </div>
    </div>
    @if (_error is not null)
    {
        <div class="badge danger mt-2">@_error</div>
    }
</div>

<div class="flex between items-center mb-4" style="font-size:var(--fs-sm)">
    <div class="flex gap-3 muted">
        <span><span class="num" style="color:var(--ink); font-weight:600">@_matchedTotal</span> matched</span>
        <span><span class="num" style="color:var(--ink); font-weight:600">@_rows.Count</span> shown</span>
    </div>
    @if (_droppedTotal > 0)
    {
        <span class="pill">⚡ @Format(_droppedTotal) not shown (rate limited)</span>
    }
</div>

<div class="table-wrap">
    <table class="data">
        <thead>
            <tr>
                <th style="width:200px">Time</th>
                <th style="width:110px">Level</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            @if (_rows.Count == 0)
            {
                <tr><td colspan="3"><div class="empty" style="padding:var(--sp-6)"><div class="glyph">≣</div><div class="muted">Waiting for events…</div></div></td></tr>
            }
            @foreach (var row in _rows)
            {
                var ts = row.Event.Timestamp.ToLocalTime();
                <tr class="clickable" @onclick="() => Toggle(row)">
                    <td class="mono-sm nowrap"><span class="muted">@ts.ToString("yyyy-MM-dd")</span> @ts.ToString("HH:mm:ss.fff")</td>
                    <td><LevelChip Level="row.Event.Level" /></td>
                    <td class="truncate" style="max-width:640px">
                        @row.Event.Message
                        @if (row.Event.EventType is { } et && _tickets.TryGetValue(et, out var url))
                        {
                            <a class="badge accent" style="margin-left:6px" href="@url" target="_blank" @onclick:stopPropagation="true">🎫</a>
                        }
                    </td>
                </tr>
                @if (row.Expanded)
                {
                    <tr>
                        <td colspan="3" style="background:var(--surface-2)">
                            <div class="grid" style="gap:var(--sp-3)">
                                <div class="kv">
                                    <dt>Message</dt><dd>@row.Event.Message</dd>
                                    @if (row.Event.Template is not null) { <dt>Template</dt><dd class="mono-sm">@row.Event.Template</dd> }
                                    @if (row.Event.Source is not null) { <dt>Source</dt><dd class="mono-sm">@row.Event.Source</dd> }
                                    @if (row.Event.TraceId is not null) { <dt>Trace</dt><dd class="mono-sm">@row.Event.TraceId</dd> }
                                </div>
                                @if (row.Event.Exception is not null)
                                {
                                    <pre class="code">@row.Event.Exception</pre>
                                }
                                @if (row.Event.Properties is { ValueKind: System.Text.Json.JsonValueKind.Object } props)
                                {
                                    <pre class="code">@System.Text.Json.JsonSerializer.Serialize(props, Indented)</pre>
                                }
                                <div class="flex gap-2 items-center">
                                    <a class="btn ghost sm" href="@($"/apps/{AppId}/events/{row.Event.Id}")">Open event</a>
                                    @if (row.Event is { Level: >= LogLevel.Error, EventType: not null })
                                    {
                                        @if (AckedByType(row.Event))
                                        {
                                            <button class="btn ghost sm" @onclick="() => Unacknowledge(row.Event)">
                                                ✓ Acknowledged — undo
                                            </button>
                                        }
                                        else if (_acks.Covers(row.Event.EventType, Micros(row.Event.Timestamp)))
                                        {
                                            <span class="badge" title="Covered by an app-wide acknowledgement — undo it from the overview">
                                                ✓ acknowledged
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="btn sm" title="Stop this error alerting on the overview until it happens again"
                                                    @onclick="() => Acknowledge(row.Event)">✓ Acknowledge</button>
                                        }
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public string AppId { get; set; } = "";

    private static readonly string[] Levels = ["Verbose", "Debug", "Information", "Warning", "Error", "Fatal"];
    private static readonly System.Text.Json.JsonSerializerOptions Indented = new() { WriteIndented = true };
    private const int MaxRows = 500;

    private sealed class Row { public required LogEventDto Event { get; init; } public bool Expanded { get; set; } }

    private readonly LinkedList<Row> _rows = new();
    private string _minLevel = "Debug";
    private string _filter = "";
    private bool _paused;
    private bool _showDocs;
    private string? _subscriptionId;
    private string? _error;
    private int _matchedTotal;
    private int _droppedTotal;

    private IReadOnlyDictionary<long, string> _tickets = new Dictionary<long, string>();
    private Logrr.Storage.Control.AckSnapshot _acks = Logrr.Storage.Control.AckSnapshot.Empty;

    protected override void OnInitialized()
    {
        _tickets = TicketLinks.TicketUrlsByEventType(AppId);
        _acks = Acks.Snapshot(AppId);
        Subscribe();
    }

    private static long Micros(DateTimeOffset ts) => Logrr.Storage.EventPartition.UnixMicros(ts);

    /// <summary>Acked by its own event type — the only ack this row can undo on its own.</summary>
    private bool AckedByType(LogEventDto e) =>
        e.EventType is { } type
        && _acks.ByEventType.TryGetValue(type, out var through)
        && Micros(e.Timestamp) <= through;

    /// <summary>Acknowledge every occurrence of this error type seen so far (SPEC §7 overview alert).</summary>
    private async Task Acknowledge(LogEventDto e)
    {
        if (e.EventType is not { } type) { return; }
        var auth = await AuthState.GetAuthenticationStateAsync();
        Acks.Acknowledge(new Logrr.Storage.Control.Ack(
            AppId,
            Logrr.Storage.Control.Ack.ScopeFor(type),
            Micros(DateTimeOffset.UtcNow),
            Note: e.Message,
            AckedBy: auth.User.Identity?.Name,
            CreatedUtc: DateTimeOffset.UtcNow));
        _acks = Acks.Snapshot(AppId);
    }

    private void Unacknowledge(LogEventDto e)
    {
        if (e.EventType is not { } type) { return; }
        Acks.Clear(AppId, Logrr.Storage.Control.Ack.ScopeFor(type));
        _acks = Acks.Snapshot(AppId);
    }

    private void Subscribe()
    {
        _error = null;
        _rows.Clear();
        try
        {
            _subscriptionId = Broker.Subscribe(
                new SubscribeRequest { AppId = AppId, MinLevel = _minLevel, Filter = string.IsNullOrWhiteSpace(_filter) ? null : _filter },
                userId: null, sink: OnFrame);
        }
        catch (Exception ex) { _error = ex.Message; return; }

        Backfill();
    }

    // Seed the tail with recent history from storage so (re)connecting isn't a blank screen
    // and a brief disconnect doesn't leave a hole (SPEC §8.5).
    private void Backfill()
    {
        try
        {
            var page = Reader.Query(new Logrr.Storage.EventQuery
            {
                AppId = AppId,
                MinLevel = Logrr.Core.LevelMap.TryParse(_minLevel, out var lvl) ? lvl : null,
                Filter = string.IsNullOrWhiteSpace(_filter) ? null : _filter,
                Limit = 100,
            });
            foreach (var e in page.Events) // newest-first
            {
                _rows.AddLast(new Row { Event = e });
            }
        }
        catch
        {
            // Backfill is best-effort; the live stream still works without it.
        }
    }

    private Task OnFrame(Frame frame) => InvokeAsync(() =>
    {
        _droppedTotal += frame.Dropped;
        if (frame.Rate is { } r) { _matchedTotal += r.Matched; }
        foreach (var e in frame.Events)
        {
            _rows.AddFirst(new Row { Event = e });
            while (_rows.Count > MaxRows) { _rows.RemoveLast(); }
        }
        StateHasChanged();
    });

    private void Resubscribe()
    {
        if (_subscriptionId is not null) { Broker.Unsubscribe(_subscriptionId); }
        Subscribe();
    }

    private void TogglePause()
    {
        if (_subscriptionId is null) { return; }
        _paused = !_paused;
        if (_paused) { Broker.Pause(_subscriptionId); } else { Broker.Resume(_subscriptionId); }
    }

    private void Toggle(Row row) => row.Expanded = !row.Expanded;
    private void Clear() => _rows.Clear();

    private static string Format(long n) => n >= 1000 ? $"{n / 1000.0:0.#}k" : n.ToString();

    public void Dispose()
    {
        if (_subscriptionId is not null) { Broker.Unsubscribe(_subscriptionId); }
    }
}
