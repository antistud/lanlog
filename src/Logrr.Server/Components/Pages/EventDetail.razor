@page "/apps/{AppId}/events/{EventId}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject Logrr.Storage.EventReader Reader
@inject Logrr.Storage.Control.AppStore Apps
@inject Logrr.Storage.Control.AckStore Acks
@inject Logrr.Notify.TicketLinkStore TicketLinks
@inject Logrr.Notify.DestinationStore Destinations
@inject Logrr.Notify.ManualTicketService Manual
@inject AuthenticationStateProvider AuthState

<PageTitle>Event @EventId — Logrr</PageTitle>

<div class="page-head">
    <div>
        <div class="meta"><a href="/">Apps</a> <span class="muted-2">/</span>
            <a href="@($"/apps/{AppId}/search")">@AppId</a> <span class="muted-2">/</span> <span class="mono-sm">event</span></div>
        <h1>Event detail</h1>
    </div>
    <div class="flex gap-2">
        @if (_link is not null && _link.TicketUrl is not null)
        {
            <a class="badge accent" href="@_link.TicketUrl" target="_blank">🎫 Linked ticket</a>
        }
        @if (CanAcknowledge)
        {
            @if (_ack is null)
            {
                <button class="btn" title="Stop this error alerting on the overview until it happens again"
                        @onclick="Acknowledge">✓ Acknowledge</button>
            }
            else
            {
                <button class="btn ghost" title="@AckTitle" @onclick="Unacknowledge">✓ Acknowledged — undo</button>
            }
        }
        <button class="btn primary" @onclick="() => _showTicket = true" disabled="@(_event is null)">Create ticket</button>
    </div>
</div>

@if (_event is null)
{
    <div class="card"><EmptyState Glyph="⌕" Title="Event not found">This event may have aged out of retention.</EmptyState></div>
}
else
{
    var e = _event;
    <div class="card">
        <div class="flex gap-3 items-center mb-4">
            <LevelChip Level="e.Level" />
            <span class="mono-sm">@e.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</span>
            <span class="flex-1"></span>
            <span class="mono-sm">@e.Id</span>
        </div>
        <h3 style="font-weight:600; margin-bottom:var(--sp-4)">@e.Message</h3>
        <dl class="kv">
            @if (e.Template is not null) { <dt>Template</dt><dd class="mono-sm">@e.Template</dd> }
            @if (e.Source is not null) { <dt>Source</dt><dd class="mono-sm">@e.Source</dd> }
            @if (e.Machine is not null) { <dt>Machine</dt><dd class="mono-sm">@e.Machine</dd> }
            @if (e.TraceId is not null) { <dt>Trace id</dt><dd class="mono-sm">@e.TraceId</dd> }
            @if (e.EventType is not null)
            {
                <dt>Event type</dt><dd class="mono-sm">@e.EventType</dd>
                <dt>Occurrences</dt><dd>@_occurrences.ToString("N0") of this type</dd>
            }
        </dl>
    </div>

    @if (e.Exception is not null)
    {
        <div class="card">
            <div class="card-head"><h3>Exception</h3></div>
            <pre class="code">@e.Exception</pre>
        </div>
    }

    @if (e.Properties is { ValueKind: System.Text.Json.JsonValueKind.Object } props)
    {
        <div class="card">
            <div class="card-head"><h3>Properties</h3></div>
            <pre class="code">@System.Text.Json.JsonSerializer.Serialize(props, Indented)</pre>
        </div>
    }

    <div class="card">
        <div class="card-head">
            <div><h3>Around this time</h3><span class="meta">What else happened within ±2 minutes, across all events.</span></div>
            @if (!_contextLoaded)
            {
                <button class="btn ghost sm" @onclick="LoadContext">Show context</button>
            }
        </div>
        @if (_contextLoaded)
        {
            <div class="table-wrap" style="border:none">
                <table class="data explore-table">
                    <tbody>
                        @foreach (var r in _context)
                        {
                            <tr class="sev-row sev-@r.Level @(r.Id == EventId ? "sel" : "")">
                                <td class="mono-sm nowrap" style="width:180px">@r.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                                <td style="width:112px"><LevelChip Level="r.Level" /></td>
                                <td class="truncate" style="max-width:520px">@r.Message</td>
                                <td class="text-right" style="width:60px">@if (r.Id != EventId) { <a href="@($"/apps/{AppId}/events/{r.Id}")">→</a> } else { <span class="badge accent">this</span> }</td>
                            </tr>
                        }
                        @if (_context.Count == 0)
                        {
                            <tr><td class="meta" style="padding:var(--sp-4)">No other events in this window.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_related.Count > 0)
    {
        <div class="card">
            <div class="card-head"><h3>Related by trace</h3><span class="badge">@_related.Count</span></div>
            <div class="table-wrap" style="border:none">
                <table class="data">
                    <tbody>
                        @foreach (var r in _related)
                        {
                            <tr>
                                <td class="mono-sm nowrap" style="width:180px">@r.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</td>
                                <td style="width:110px"><LevelChip Level="r.Level" /></td>
                                <td class="truncate" style="max-width:520px">@r.Message</td>
                                <td class="text-right" style="width:80px">@if (r.Id != e.Id) { <a href="@($"/apps/{AppId}/events/{r.Id}")">→</a> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<Modal @bind-Open="_showTicket" Title="Create ticket">
    <ChildContent>
        @if (_destinations.Count == 0)
        {
            <p class="muted">No destinations configured. Add one under <a href="/destinations">Destinations</a> first.</p>
        }
        else
        {
            <div class="field">
                <label>Destination</label>
                <select class="input" @bind="_destId">
                    @foreach (var d in _destinations) { <option value="@d.Id">@d.Name</option> }
                </select>
            </div>
            <div class="field">
                <label>Title <span class="muted-2">(optional, template override)</span></label>
                <input class="input" @bind="_title" />
            </div>
            <div class="field">
                <label>Body <span class="muted-2">(optional)</span></label>
                <textarea class="input" @bind="_body" rows="4"></textarea>
            </div>
            @if (_ticketMsg is not null)
            {
                <div class="badge @(_ticketOk ? "good" : "danger")">@_ticketMsg</div>
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn ghost" @onclick="() => _showTicket = false">Cancel</button>
        <button class="btn primary" @onclick="SubmitTicket" disabled="@(_destinations.Count == 0)">Submit</button>
    </Footer>
</Modal>

@code {
    [Parameter] public string AppId { get; set; } = "";
    [Parameter] public string EventId { get; set; } = "";

    private static readonly System.Text.Json.JsonSerializerOptions Indented = new() { WriteIndented = true };

    private LogEventDto? _event;
    private readonly List<LogEventDto> _related = new();
    private readonly List<LogEventDto> _context = new();
    private bool _contextLoaded;
    private Logrr.Notify.TicketLink? _link;
    private Logrr.Storage.Control.Ack? _ack;
    private long _occurrences;
    private IReadOnlyList<Logrr.Notify.Destination> _destinations = [];

    private bool _showTicket;
    private string _destId = "", _title = "", _body = "";
    private string? _ticketMsg;
    private bool _ticketOk;

    protected override void OnInitialized()
    {
        _event = Reader.GetById(AppId, EventId);
        _destinations = Destinations.List().Where(d => d.IsEnabled).ToList();
        if (_destinations.Count > 0) { _destId = _destinations[0].Id; }

        if (_event is null) { return; }

        if (_event.EventType is { } type)
        {
            _link = TicketLinks.FindByEventType(AppId, type);
            _occurrences = Reader.CountByEventType(AppId, type);
            LoadAck();
        }
        if (_event.TraceId is { } trace)
        {
            var page = Reader.Query(new Logrr.Storage.EventQuery { AppId = AppId, Filter = $"TraceId = '{trace}'", Limit = 50 });
            _related.AddRange(page.Events);
        }
    }

    private void LoadContext()
    {
        _contextLoaded = true;
        if (_event is null) { return; }
        var window = TimeSpan.FromMinutes(2);
        var page = Reader.Query(new Logrr.Storage.EventQuery
        {
            AppId = AppId,
            From = _event.Timestamp - window,
            To = _event.Timestamp + window,
            Limit = 80,
        });
        _context.AddRange(page.Events); // newest-first
    }

    /// <summary>Only errors alert on the overview, and an ack is scoped to an event type.</summary>
    private bool CanAcknowledge => _event is { Level: >= LogLevel.Error, EventType: not null };

    private string AckTitle => _ack is null ? ""
        : $"Acknowledged{(_ack.AckedBy is null ? "" : $" by {_ack.AckedBy}")} at " +
          $"{_ack.CreatedUtc.ToLocalTime():yyyy-MM-dd HH:mm} — click to undo";

    /// <summary>
    /// An ack only counts while its watermark still covers this event; a recurrence after the
    /// ack is unacknowledged again, and the button offers to acknowledge afresh.
    /// </summary>
    private void LoadAck()
    {
        _ack = null;
        if (_event?.EventType is not { } type) { return; }
        var scope = Logrr.Storage.Control.Ack.ScopeFor(type);
        if (Acks.Find(AppId, scope) is { } ack
            && ack.ThroughTs >= Logrr.Storage.EventPartition.UnixMicros(_event.Timestamp))
        {
            _ack = ack;
        }
    }

    private async Task Acknowledge()
    {
        if (_event?.EventType is not { } type) { return; }
        var auth = await AuthState.GetAuthenticationStateAsync();
        Acks.Acknowledge(new Logrr.Storage.Control.Ack(
            AppId,
            Logrr.Storage.Control.Ack.ScopeFor(type),
            Logrr.Storage.EventPartition.UnixMicros(DateTimeOffset.UtcNow),
            Note: _event.Message,
            AckedBy: auth.User.Identity?.Name,
            CreatedUtc: DateTimeOffset.UtcNow));
        LoadAck();
    }

    private void Unacknowledge()
    {
        if (_event?.EventType is not { } type) { return; }
        Acks.Clear(AppId, Logrr.Storage.Control.Ack.ScopeFor(type));
        LoadAck();
    }

    private async Task SubmitTicket()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var appName = Apps.Get(AppId)?.Name;
        var ev = _event is null ? null : ToEvent(_event);
        var result = Manual.Submit(_destId, AppId, appName, ev, EventId,
            string.IsNullOrWhiteSpace(_title) ? null : _title,
            string.IsNullOrWhiteSpace(_body) ? null : _body,
            auth.User.Identity?.Name);
        _ticketOk = result.Error is null;
        _ticketMsg = result.Error ?? "Queued for delivery.";
    }

    private static Logrr.Core.LogEvent ToEvent(LogEventDto d) => new()
    {
        Timestamp = d.Timestamp, Level = d.Level, Template = d.Template, Message = d.Message,
        Exception = d.Exception, EventType = d.EventType ?? 0, TraceId = d.TraceId, Source = d.Source,
        Properties = new Dictionary<string, object?>(),
    };
}
