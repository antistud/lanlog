@if (Open)
{
    <div class="modal-backdrop" @onclick="Backdrop">
        <div class="modal @(Wide ? "wide" : "")" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="m-head">
                <h3>@Title</h3>
                <button class="btn ghost icon" @onclick="() => Close()" aria-label="Close">✕</button>
            </div>
            <div class="m-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="m-foot">@Footer</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Wide { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private async Task Close()
    {
        Open = false;
        await OpenChanged.InvokeAsync(false);
    }

    private async Task Backdrop()
    {
        if (CloseOnBackdrop) { await Close(); }
    }
}
