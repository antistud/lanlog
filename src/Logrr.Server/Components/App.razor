<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Logrr</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ctext y='13' font-size='13'%3E%E2%96%9A%3C/text%3E%3C/svg%3E" />
    <link rel="stylesheet" href="css/logrr.css" />
    <script>
        // Apply the saved theme before first paint to avoid a flash.
        (function () {
            var m = localStorage.getItem('logrr-theme');
            if (m === 'light' || m === 'dark') document.documentElement.setAttribute('data-theme', m);
        })();
    </script>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="js/theme.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Enhanced navigation restores <html> from the server markup, dropping data-theme.
        Blazor.addEventListener('enhancedload', function () { window.logrrTheme.restore(); });
        window.logrrTheme.restore();
    </script>
</body>
</html>
