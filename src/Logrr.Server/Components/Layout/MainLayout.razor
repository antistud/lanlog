@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        @if (_mustChange)
        {
            <div class="main">@Body</div>
        }
        else
        {
        <div class="app">
            <aside class="sidebar">
                <div class="brand"><span class="glyph">▚</span> Logrr</div>

                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                    <span class="ico">◫</span> Apps
                </NavLink>

                @if (_appId is not null)
                {
                    <div class="nav-group">
                        <div class="label">@_appId</div>
                        <NavLink class="nav-link" href="@($"/apps/{_appId}/tail")"><span class="ico">≣</span> Live tail</NavLink>
                        <NavLink class="nav-link" href="@($"/apps/{_appId}/search")"><span class="ico">⌕</span> Search</NavLink>
                        <NavLink class="nav-link" href="@($"/apps/{_appId}/tokens")"><span class="ico">⚿</span> Tokens</NavLink>
                        <NavLink class="nav-link" href="@($"/apps/{_appId}/settings")"><span class="ico">⚙</span> Settings</NavLink>
                    </div>
                }

                <div class="nav-group">
                    <div class="label">Alerting</div>
                    <NavLink class="nav-link" href="/destinations"><span class="ico">➤</span> Destinations</NavLink>
                    <NavLink class="nav-link" href="/rules"><span class="ico">❃</span> Rules</NavLink>
                    <NavLink class="nav-link" href="/deliveries"><span class="ico">✉</span> Deliveries</NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="admin">
                    <div class="nav-group">
                        <div class="label">System</div>
                        <NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All"><span class="ico">◉</span> Admin</NavLink>
                        <NavLink class="nav-link" href="/admin/windows-events"><span class="ico">▤</span> Windows events</NavLink>
                    </div>
                </AuthorizeView>

                <div class="spacer"></div>

                <div class="row" style="justify-content:space-between; padding:0 var(--sp-2)">
                    <a class="meta" href="/account/password" title="Change password">@context.User.Identity?.Name</a>
                    <div class="flex gap-2">
                        <button class="btn ghost icon" title="Toggle theme" data-theme-toggle
                                onclick="window.logrrTheme.cycle();">◐</button>
                        <form method="post" action="/auth/logout" style="display:inline">
                            <button class="btn ghost icon" type="submit" title="Sign out">⎋</button>
                        </form>
                    </div>
                </div>
            </aside>

            <div class="main">
                <div class="content">
                    @Body
                </div>
            </div>
        </div>
        }
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? _appId;
    private bool _mustChange;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Recompute();
    }

    protected override async Task OnParametersSetAsync() => await EnforcePasswordChange();

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        Recompute();
        _ = EnforcePasswordChange();
        StateHasChanged();
    }

    // A user still owing a password change is confined to the change-password page (SPEC §2).
    private async Task EnforcePasswordChange()
    {
        if (AuthState is null) { return; }
        var state = await AuthState;
        _mustChange = state.User.HasClaim(Logrr.Server.Auth.AuthEndpoints.MustChangeClaim, "1");
        if (!_mustChange) { return; }

        var path = new Uri(Nav.Uri).AbsolutePath;
        if (!path.Equals("/account/password", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/account/password");
        }
    }

    private void Recompute()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        _appId = segments.Length >= 2 && segments[0] == "apps" ? segments[1] : null;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
