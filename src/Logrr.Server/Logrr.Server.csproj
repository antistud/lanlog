<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Ship the host as Logrr.exe (not Logrr.Server.exe) so it matches web.config's
         processPath=".\Logrr.exe" and the on-disk layout in docs/SPEC.md §2 / docs/SETUP.md. -->
    <AssemblyName>Logrr</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Diagnostics.Eventing.Reader (the Windows Event Log collector, SPEC §6.4) needs no
         PackageReference: the ASP.NET Core shared framework already carries
         System.Diagnostics.EventLog, and adding it explicitly only earns NU1510. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- ANCM writes its stdout capture to .\logs\stdout_*.log but will NOT create the folder.
       A publish without it means web.config's stdoutLogEnabled="true" silently produces
       nothing - which is exactly when you need it. Create it as part of publish. -->
  <Target Name="CreateAncmLogDir" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)logs" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Logrr.Contracts\Logrr.Contracts.csproj" />
    <ProjectReference Include="..\Logrr.Core\Logrr.Core.csproj" />
    <ProjectReference Include="..\Logrr.Storage\Logrr.Storage.csproj" />
    <ProjectReference Include="..\Logrr.Realtime\Logrr.Realtime.csproj" />
    <ProjectReference Include="..\Logrr.Notify\Logrr.Notify.csproj" />
  </ItemGroup>

</Project>
