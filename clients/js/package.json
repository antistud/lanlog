{
  "name": "@logrr/client",
  "version": "1.0.0",
  "description": "Ship structured logs to a Logrr server from Node.js and the browser.",
  "keywords": [
    "logging",
    "logrr",
    "clef",
    "seq",
    "structured-logging",
    "log-shipping"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antistud/lanlog.git",
    "directory": "clients/js"
  },
  "homepage": "https://github.com/antistud/lanlog/tree/main/clients/js#readme",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
