<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Must stay false: Microsoft.Data.SqlClient throws
         "Globalization Invariant Mode is not supported" from SqlConnection.Open(), so the
         optional SQL Server backend (SPEC §4.7) simply cannot connect in invariant mode. The
         failure is at connect time, not build time, so turning this back on would ship a build
         where the SQLite backend works and the SQL Server one dies on first use. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Deployment target is win-x64 self-contained (see docs/SPEC.md §2).
         Development/CI builds run cross-platform; the RID is applied at publish time. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- MailKit/MimeKit power SMTP email destinations. These moderate advisories concern
         PARSING of untrusted MIME, which Logrr never does (it only composes and sends mail),
         and no fixed version is published. Suppress solution-wide so audit stays clean. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-9j88-vvj5-vhgr" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g7hc-96xr-gvvx" />
  </ItemGroup>

</Project>
